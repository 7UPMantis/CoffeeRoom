<view class="page order-page">
  <!-- 顾客视角：今天想喝什么 -->
  <view class="hero">
    <view class="hero-text">
      <view class="hero-title">今天想喝点什么</view>
      <view class="hero-sub">{{recipes.length}} 款饮品</view>
    </view>
    <view class="hero-badge">☕</view>
  </view>

  <view class="search">
    <input placeholder="搜饮品、标签" placeholder-class="ph" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">×</text>
  </view>

  <scroll-view class="chip-scroll" scroll-x enable-flex>
    <view wx:for="{{categories}}" wx:key="key"
          class="chip {{activeCat === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="onCatTap">{{item.icon}} {{item.label}}</view>
  </scroll-view>

  <view class="list-head">
    <text class="section-title">选一杯</text>
    <text class="muted quick-fav" bindtap="onQuickFav">★ 常喝一键加</text>
  </view>

  <!-- 菜单卡片：只有名字、分类、标签、杯数 -->
  <view class="recipe-grid">
    <view wx:for="{{list}}" wx:key="_id" class="r-card">
      <image wx:if="{{item._hasCover}}" class="r-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view class="r-name">{{item.name}}</view>
      <view class="r-cat">{{item._catIcon}} {{item._catLabel}}</view>
      <view class="r-tags">
        <text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" class="tag">{{tg}}</text>
      </view>
      <view class="r-bottom">
        <view wx:if="{{item.favorite}}" class="r-fav">★ 常喝</view>
        <view wx:else class="placeholder-fav"></view>
        <view class="stepper">
          <view wx:if="{{cart[item._id]}}" class="st-btn" data-id="{{item._id}}" bindtap="onMinus">−</view>
          <text wx:if="{{cart[item._id]}}" class="st-num">{{cart[item._id]}}</text>
          <view class="st-btn add" data-id="{{item._id}}" bindtap="onPlus">＋</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!list.length}}" class="empty">
    <text class="empty-icon">☕</text>
    <view>这个分类还没有饮品</view>
    <view class="muted" style="margin-top:16rpx" bindtap="onGoQueue">去「配方」页添加一款</view>
  </view>
</view>

<!-- 底部购物车 -->
<view wx:if="{{cartCount}}" class="cart-bar">
  <view class="cart-info" bindtap="onCartTap">
    <view class="cart-count">{{cartCount}} 杯</view>
    <view class="cart-desc">{{cartList[0].name}}<text wx:if="{{cartList.length > 1}}"> 等 {{cartList.length}} 款</text></view>
  </view>
  <view class="cart-btn" bindtap="onCartTap">去下单</view>
</view>

<!-- 下单弹层：选豆在这里 -->
<view wx:if="{{showSheet}}" class="mask" bindtap="onCloseSheet"></view>
<view wx:if="{{showSheet}}" class="sheet" catchtap="stopPop">
  <view class="sheet-title">确认点单</view>

  <scroll-view class="sheet-items" scroll-y>
    <view wx:for="{{cartList}}" wx:key="id" class="sheet-item">
      <view class="si-left">
        <view class="si-row">
          <text class="si-name">{{item.name}}</text>
          <text class="si-count">× {{item.count}}</text>
        </view>
        <picker wx:if="{{!item.noBean && !item.beanLocked}}" mode="selector" range="{{item.beanOptions}}" range-key="name"
                value="{{item.beanIndex}}" data-index="{{index}}" bindchange="onBeanChange">
          <view class="si-bean">
            <text class="si-bean-label">用豆</text>
            <text class="si-bean-name">{{item.beanOptions[item.beanIndex].name}}</text>
            <text class="si-bean-arrow">▾</text>
          </view>
        </picker>
        <view wx:elif="{{item.beanLocked}}" class="si-bean locked">
          <text class="si-bean-label">用豆</text>
          <text class="si-bean-name">{{item.beanName}}</text>
        </view>
        <view wx:else class="si-bean empty">豆仓里还没有能用于这款的豆</view>
      </view>
    </view>
  </scroll-view>

  <view class="form-row">
    <text class="form-label">给谁做</text>
    <input class="form-value" placeholder="爸爸 / 妈妈 / 自己" placeholder-class="ph" value="{{forWho}}" bindinput="onForWho" />
  </view>
  <view class="form-row">
    <text class="form-label">备注</text>
    <input class="form-value" placeholder="少糖、多奶、去冰…" placeholder-class="ph" value="{{note}}" bindinput="onNote" />
  </view>

  <view class="sheet-actions">
    <view class="btn-ghost" style="flex:1;margin-right:20rpx" bindtap="onCloseSheet">再看看</view>
    <view class="btn-primary" style="flex:1" bindtap="onSubmit">提交 {{cartCount}} 杯</view>
  </view>
</view>
