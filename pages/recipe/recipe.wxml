<view class="page">
  <!-- 待做队列：点单之后的交接区，制作者在这里认领 -->
  <view wx:if="{{queue.length}}" class="card queue-card">
    <view class="q-head">
      <view>
        <view class="section-title">待做 {{queueCups}} 杯</view>
        <view class="muted">{{queue.length}} 张单子等着做</view>
      </view>
      <view class="q-badge">{{queueCups}}</view>
    </view>

    <view wx:for="{{queue}}" wx:key="_id" class="q-order">
      <view class="q-meta">
        <text class="q-who">给 {{item.forWho}}</text>
        <text class="q-time">{{item.timeText}}</text>
      </view>

      <view wx:for="{{item.items}}" wx:for-item="it" wx:key="recipeId" class="q-item"
            data-id="{{it.recipeId}}" data-order="{{item._id}}" bindtap="onBrewFromQueue">
        <view class="q-item-body">
          <view class="q-item-top">
            <text class="q-item-name">{{it.name}}</text>
            <text class="q-item-count">× {{it.count}}</text>
          </view>
          <view class="q-item-sub">
            <text wx:if="{{it.beanName}}">用豆 {{it.beanName}}</text>
            <text wx:else>下单时没选豆</text>
          </view>
        </view>
        <text class="q-go">冲煮 ›</text>
      </view>

      <view wx:if="{{item.note}}" class="q-note">备注：{{item.note}}</view>

      <view class="q-actions">
        <text class="op" data-id="{{item._id}}" bindtap="onQueueDone">整单完成</text>
      </view>
    </view>
  </view>

  <view class="search">
    <input placeholder="搜配方、标签、器具" placeholder-class="ph" value="{{keyword}}" bindinput="onSearch" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="onClearSearch">×</text>
  </view>

  <scroll-view class="chip-scroll" scroll-x enable-flex>
    <view wx:for="{{categories}}" wx:key="key"
          class="chip {{activeCat === item.key ? 'active' : ''}}"
          data-key="{{item.key}}" bindtap="onCatTap">{{item.icon}} {{item.label}}</view>
  </scroll-view>

  <view class="list-head">
    <text class="section-title">我的配方</text>
    <text class="muted">{{list.length}} / {{all.length}}</text>
  </view>

  <view wx:for="{{groups}}" wx:for-item="g" wx:key="key" class="group">
    <!-- 分组标题：常喝置顶，其余按分类，可折叠 -->
    <view wx:if="{{grouped}}" class="group-head" data-key="{{g.key}}" bindtap="onToggleGroup">
      <view class="gh-left">
        <text class="gh-icon">{{g.icon}}</text>
        <text class="gh-label">{{g.label}}</text>
        <text class="gh-count">{{g.items.length}}</text>
      </view>
      <text class="gh-arrow {{g.collapsed ? 'folded' : 'open'}}">{{g.collapsed ? '▸' : '▾'}}</text>
    </view>

    <block wx:if="{{!g.collapsed}}">
      <view wx:for="{{g.items}}" wx:for-item="item" wx:key="_id" class="card recipe-card">
        <view class="rc-body" data-id="{{item._id}}" bindtap="onEdit">
          <image wx:if="{{item.cover}}" class="rc-thumb" src="{{item.cover}}" mode="aspectFill" lazy-load />
          <view wx:else class="rc-thumb rc-thumb-ph">{{item._catIcon}}</view>
          <view class="rc-main">
            <view class="rc-title">
              <text class="rc-name">{{item.name}}</text>
              <text wx:if="{{item.favorite}}" class="rc-star">★</text>
            </view>
            <view class="rc-spec" wx:if="{{item._specLine}}">{{item._specLine}}</view>
            <view class="rc-tags">
              <text class="tag">{{item._beanTypeLabel}}</text>
              <text wx:if="{{item.beanName}}" class="tag">{{item.beanName}}</text>
              <text wx:else class="tag grey">未设默认豆</text>
              <text wx:for="{{item._tags}}" wx:for-item="tg" wx:key="*this" class="tag grey">{{tg}}</text>
              <text wx:if="{{item._moreTags}}" class="tag grey">+{{item._moreTags}}</text>
              <text wx:if="{{item.grind}}" class="tag grey">{{item.grind}}研磨</text>
            </view>
          </view>
        </view>

        <view class="rc-ops">
          <text class="op brew" data-id="{{item._id}}" catchtap="onBrew">▶ 冲煮</text>
          <text class="op" data-id="{{item._id}}" catchtap="onToggleFav">{{item.favorite ? '取消常喝' : '设常喝'}}</text>
          <text class="op danger" data-id="{{item._id}}" data-name="{{item.name}}" catchtap="onDelete">删除</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{!list.length}}" class="empty">
    <text class="empty-icon">📖</text>
    <view wx:if="{{all.length}}">没有匹配的配方</view>
    <view wx:else>还没有配方</view>
    <view class="muted" style="margin-top:16rpx">点右下角 ＋ 记录第一杯</view>
  </view>
</view>

<view class="fab" bindtap="onAdd">＋</view>
