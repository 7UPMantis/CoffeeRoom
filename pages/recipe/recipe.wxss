.search-clear {
  color: var(--text-3);
  font-size: 40rpx;
  padding: 0 8rpx;
  line-height: 1;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 0 4rpx;
}

/* ---------- 分组（常喝置顶 + 按分类） ---------- */
.group {
  margin-bottom: 6rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 8rpx 12rpx;
}

.gh-left {
  display: flex;
  align-items: baseline;
}

.gh-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.gh-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--coffee-dark);
}

.gh-count {
  font-size: 21rpx;
  color: var(--text-2);
  margin-left: 12rpx;
  background: var(--surface-3);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.gh-arrow {
  font-size: 24rpx;
  color: var(--text-3);
  padding: 0 10rpx;
}

.gh-arrow.open {
  color: var(--coffee);
}

/* ---------- 配方卡片（紧凑版：封面缩略图 + 主信息两栏） ---------- */
.recipe-card {
  padding: 22rpx 24rpx 18rpx;
}

.rc-body {
  display: flex;
  align-items: flex-start;
}

.rc-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--r-md);
  flex-shrink: 0;
  margin-right: 20rpx;
  background: var(--surface-2);
  display: block;
}

/* 没有封面时用分类图标占位，保持左侧对齐不塌陷 */
.rc-thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  color: var(--coffee-light);
}

.rc-main {
  flex: 1;
  min-width: 0;
}

.rc-title {
  display: flex;
  align-items: center;
}

.rc-name {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--coffee-dark);
  letter-spacing: 0.5rpx;
}

.rc-star {
  color: var(--gold);
  font-size: 24rpx;
  margin-left: 10rpx;
}

/* 参数压成一行：器具 · 粉→液 · 粉水比 · 水温 · 时长 */
.rc-spec {
  font-size: 23rpx;
  color: var(--text-2);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rc-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
  /* 抵消 .tag 自带的下边距 */
  margin-bottom: -8rpx;
}

.rc-ops {
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.op {
  font-size: 24rpx;
  color: var(--coffee);
  padding: 8rpx 12rpx;
}

.op.brew {
  color: var(--coffee-dark);
  font-weight: 500;
}

.op.danger {
  color: var(--red);
}

.ph {
  color: var(--text-3);
}

/* ---------- 待做队列 ---------- */
.queue-card {
  border-left: 6rpx solid var(--coffee);
}

.q-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.q-badge {
  min-width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7B5940 0%, #6F4E37 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 64rpx;
  padding: 0 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(111, 78, 55, 0.25);
}

.q-order {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.q-order:first-of-type {
  border-top: none;
  padding-top: 8rpx;
}

.q-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.q-who {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--coffee-dark);
}

.q-time {
  font-size: 21rpx;
  color: var(--text-3);
}

.q-item {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 18rpx 22rpx;
}

.q-item-body {
  flex: 1;
  min-width: 0;
}

.q-item-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.q-item-name {
  font-size: 28rpx;
  color: var(--text);
}

.q-item-count {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--coffee);
}

.q-item-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-2);
}

.q-go {
  flex-shrink: 0;
  margin-left: 18rpx;
  font-size: 23rpx;
  color: var(--coffee);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  padding: 9rpx 20rpx;
}

.q-note {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--text-2);
}

.q-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}
