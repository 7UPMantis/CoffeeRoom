.search-clear {
  color: var(--text-3);
  font-size: 40rpx;
  padding: 0 8rpx;
  line-height: 1;
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 26rpx 0 4rpx;
}

.recipe-card {
  padding: 30rpx 28rpx 22rpx;
}

.rc-head {
  margin-bottom: 20rpx;
}

.rc-title {
  display: flex;
  align-items: center;
}

.rc-name {
  font-size: 35rpx;
  font-weight: 600;
  color: var(--coffee-dark);
  letter-spacing: 0.5rpx;
}

.rc-star {
  color: var(--gold);
  font-size: 28rpx;
  margin-left: 12rpx;
}

.rc-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

/* 参数区 */
.rc-params {
  display: flex;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 22rpx 0;
  margin-bottom: 18rpx;
}

.param {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--line);
}

.param:last-child {
  border-right: none;
}

.p-val {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--coffee);
  line-height: 1.2;
}

.p-key {
  display: block;
  font-size: 20rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

/* 底部改为纵向堆叠：标签独占整行自由换行，操作区另起一行右对齐，
   避免标签多时和「设常喝 / 删除」抢横向空间 */
.rc-foot {
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.rc-tags {
  display: flex;
  flex-wrap: wrap;
  /* 抵消 .tag 自带的下边距，免得底部多出一截空隙 */
  margin-bottom: -8rpx;
}

.rc-ops {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.op {
  font-size: 24rpx;
  color: var(--coffee);
  padding: 8rpx 12rpx;
}

.op.danger {
  color: var(--red);
}

.ph {
  color: var(--text-3);
}

/* ---------- 封面 ---------- */
.rc-cover {
  width: 100%;
  height: 240rpx;
  border-radius: var(--r-md);
  margin-bottom: 22rpx;
  background: var(--surface-2);
  display: block;
}

/* ---------- 冲煮入口 ---------- */
.op.brew {
  color: var(--coffee-dark);
  font-weight: 500;
}

.rc-ops {
  gap: 8rpx;
}

/* ---------- 待做队列 ---------- */
.queue-card {
  border-left: 6rpx solid var(--coffee);
}

.q-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.q-badge {
  min-width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #7B5940 0%, #6F4E37 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 64rpx;
  padding: 0 20rpx;
  box-shadow: 0 6rpx 16rpx rgba(111, 78, 55, 0.25);
}

.q-order {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.q-order:first-of-type {
  border-top: none;
  padding-top: 8rpx;
}

.q-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.q-who {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--coffee-dark);
}

.q-time {
  font-size: 21rpx;
  color: var(--text-3);
}

.q-item {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 18rpx 22rpx;
}

.q-item-body {
  flex: 1;
  min-width: 0;
}

.q-item-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.q-item-name {
  font-size: 28rpx;
  color: var(--text);
}

.q-item-count {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--coffee);
}

.q-item-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-2);
}

.q-go {
  flex-shrink: 0;
  margin-left: 18rpx;
  font-size: 23rpx;
  color: var(--coffee);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  padding: 9rpx 20rpx;
}

.q-note {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--text-2);
}

.q-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
}
