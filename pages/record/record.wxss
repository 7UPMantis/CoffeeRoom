.stat-card {
  display: flex;
  align-items: center;
  padding: 34rpx 28rpx;
  background: linear-gradient(160deg, #FFFDFB 0%, #FBF4EC 100%);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 46rpx;
  font-weight: 600;
  color: var(--coffee);
  line-height: 1.2;
}

.stat-key {
  display: block;
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

.stat-div {
  width: 1rpx;
  height: 62rpx;
  background: var(--line);
}

.list-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 30rpx 0 4rpx;
}

.order-card {
  padding: 28rpx 28rpx 22rpx;
}

.oc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.oc-who {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--coffee-dark);
}

.oc-items {
  margin-top: 18rpx;
  background: var(--surface-2);
  border-radius: var(--r-md);
  padding: 10rpx 24rpx;
}

.oc-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 27rpx;
  border-bottom: 1rpx solid var(--line);
}

.oc-item:last-child {
  border-bottom: none;
}

.oi-name {
  color: var(--text);
}

.oi-left {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.oi-bean {
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}

.oi-count {
  color: var(--coffee);
  font-weight: 600;
}

.oc-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-2);
}

.oc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.oc-time {
  font-size: 22rpx;
  color: var(--text-3);
}

.oc-ops {
  flex-shrink: 0;
}

.op {
  font-size: 24rpx;
  color: var(--coffee);
  padding: 8rpx 12rpx;
}

.op.danger {
  color: var(--red);
}

.row-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rl-key {
  font-size: 27rpx;
  color: var(--text-2);
}

.rl-val {
  font-size: 27rpx;
  color: var(--text);
}

.btn-row {
  display: flex;
  margin-top: 30rpx;
}

.btn-row .btn-ghost {
  flex: 1;
}

.btn-row .btn-ghost:first-child {
  margin-right: 20rpx;
}

.tip-text {
  margin-top: 26rpx;
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.75;
}

/* ---------- 近 7 日柱状图 ---------- */
.chart-card {
  margin-top: 20rpx;
  padding: 28rpx 24rpx 20rpx;
}

.chart-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.chart {
  display: flex;
  align-items: flex-end;
}

.chart-col {
  flex: 1;
  text-align: center;
}

.chart-cups {
  font-size: 20rpx;
  color: var(--text-2);
  height: 28rpx;
  line-height: 28rpx;
}

.chart-bar-wrap {
  height: 140rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 8rpx;
}

.chart-bar {
  width: 100%;
  max-width: 40rpx;
  border-radius: 8rpx 8rpx 4rpx 4rpx;
  background: linear-gradient(180deg, #8B6B52 0%, #6F4E37 100%);
  min-height: 0;
}

.chart-label {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}

/* ---------- 消耗构成 ---------- */
.cat-list {
  margin-top: 22rpx;
}

.cat-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.cat-name {
  width: 150rpx;
  font-size: 24rpx;
  color: var(--text);
  flex-shrink: 0;
}

.cat-bar-wrap {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--surface-3);
  overflow: hidden;
  margin-right: 16rpx;
}

.cat-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #B08E72 0%, #6F4E37 100%);
}

.cat-val {
  font-size: 21rpx;
  color: var(--text-2);
  flex-shrink: 0;
  min-width: 130rpx;
  text-align: right;
}

/* ---------- 排行 ---------- */
.rank-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.rank-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--coffee-dark);
  margin-bottom: 18rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.rank-name {
  width: 160rpx;
  font-size: 24rpx;
  color: var(--text);
  flex-shrink: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.rank-bar-wrap {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--surface-3);
  overflow: hidden;
  margin-right: 16rpx;
}

.rank-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #C19A6B 0%, #8B6B52 100%);
}

.rank-val {
  font-size: 21rpx;
  color: var(--text-2);
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: right;
}

.top-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: -8rpx;
}

/* ---------- 状态筛选 ---------- */
.status-row {
  display: flex;
  margin: 4rpx 0 20rpx;
}

.st-chip {
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
}

.st-chip.active {
  background: var(--coffee-tint);
  border-color: var(--coffee-light);
  color: var(--coffee-dark);
  font-weight: 500;
}

/* ---------- 耗豆行 ---------- */
.oc-usage {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--coffee-mid);
}
